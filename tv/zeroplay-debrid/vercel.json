{
  "redirects": [
    {
      "source": "/tv.apk",
      "destination": "https://github.com/regularshowrigby8-create/SAVAGE-TECH-CORNER-/releases/download/zeroplay-tv-v1.0.3/zeroplay-tv.apk",
      "permanent": false
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --ignore-scripts --no-audit --no-fund",
  "rewrites": [
    {
      "source": "/movie/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tv/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/movies",
      "destination": "/index.html"
    },
    {
      "source": "/series",
      "destination": "/index.html"
    },
    {
      "source": "/library",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/categories",
      "destination": "/index.html"
    },
    {
      "source": "/discover",
      "destination": "/index.html"
    },
    {
      "source": "/sources",
      "destination": "/index.html"
    },
    {
      "source": "/configure",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/downloads",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; connect-src 'self' https:; frame-src https:; media-src https: blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
