{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node web/scripts/build.cjs",
  "outputDirectory": "web/public",
  "rewrites": [
    {"source":"/movie/:id","destination":"/index.html"},
    {"source":"/tv/:id","destination":"/index.html"},
    {"source":"/movies","destination":"/index.html"},
    {"source":"/series","destination":"/index.html"},
    {"source":"/library","destination":"/index.html"},
    {"source":"/search","destination":"/index.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://image.tmdb.org data:; connect-src 'self'; frame-src https://vidstuck.cc https://zxcstream.cc https://embedwave.cc https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=86400"}
      ]
    }
  ]
}
