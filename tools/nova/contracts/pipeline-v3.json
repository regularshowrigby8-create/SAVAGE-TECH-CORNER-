        "Traceback"
      ],
      "json_path": "result",
      "json_assertions": [
        {
          "path": "ok",
          "equals": true
        },
        {
          "path": "total",
          "min": 7
        },
        {
          "path": "passed",
          "min": 7
        },
        {
          "path": "failed",
          "equals": 0
        },
        {
          "path": "errors",
          "empty": true
        }
      ]
    },
    {
