    "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineLooker.kt",
    "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineExtractor.kt",
    "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineVerifier.kt",
    "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineAdapters.kt",
    "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineRunner.kt"
  ],
  "required_patterns": [
    {
      "id": "gate-fails-closed",
      "globs": [
        "tools/nova/strict_verify.py",
        "tools/nova/tests/test_strict_verify.py"
      ],
      "patterns": [
        "class GateFailure",
        "def worktree_fingerprint",
        "test_top_level_green_cannot_mask_failed_nested_result",
        "test_artifact_checker_refuses_to_infer_sdk",
        "verification_outputs_excluded_from_fingerprint"
      ]
    },
    {
      "id": "pipeline-v3-model",
      "globs": [
        "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineModels.kt"
      ],
      "patterns": [
        "PIPELINE_BUILD_MARKER = \"nova-finder-pipeline-v3\"",
        "MIN_SITE_TARGET = 10_000",
        "MIN_ENGINE_COUNT = 50",
        "14-audit"
      ]
    },
    {
      "id": "pipeline-kind-aware-and-network-aware",
      "globs": [
        "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/DiscoveryEngines.kt",
        "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineRunner.kt"
      ],
      "patterns": [
        "fun find\\(url: String, kind: PipelineKind\\? = null\\)",
        "EngineRegistry\\.parse\\(result\\.url, result\\.body, kind\\)",
        "network = evidence.network"
      ]
    },
    {
      "id": "pipeline-bounded-addon-probes",
      "globs": [
        "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineLooker.kt",
        "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineModels.kt"
      ],
      "patterns": [
        "probeIds\\.take\\(1\\)",
        "val network: List<String> = emptyList\\(\\)"
      ]
    },
    {
      "id": "pipeline-capacity-unit-test",
      "globs": [
        "nova-tv/android/app/src/test/java/dev/nova/tv/finder/pipeline/PipelineRunnerTest.kt"
      ],
      "patterns": [
        "class PipelineRunnerTest",
        "assertEquals\\(MIN_SITE_TARGET, second\\.verifiedCount\\)",
        "assertEquals\\(\"TARGET_MET\", second\\.status\\)",
        "corporate MP4 must not be suitable"
      ]
    },
    {
      "id": "strict-nested-result-semantics",
      "globs": [
        "nova-tv/python/nova/result.py",
        "nova-tv/python/nova/cli.py",
        "nova-tv/python/ops/assert_script_result.py"
      ],
      "patterns": [
        "def result_failures\\(",
        "def payload_is_ok\\(",
        "STRICT RESULT FAIL"
      ]
    },
    {
      "id": "ci-honesty-checks",
      "globs": [
        ".github/workflows/nova-tv-android.yml",
        ".github/workflows/nova-tv-python.yml",
        "tools/nova/check_artifacts.py",
        "tools/nova/run_ci_artifact_check.sh"
      ],
      "patterns": [
        "testTvDebugUnitTest",
        "testMobileDebugUnitTest",
        "check_artifacts.py",
        "qa_offline_gates.py",
        "assert_script_result.py",
        "if-no-files-found: error",
        "NOVA_BUILD_TOOLS"
      ]
    },
    {
      "id": "docs-state-limitations",
      "globs": [
        "nova-tv/docs/FINDER.md",
        "nova-tv/docs/BUILD-STATUS.md"
      ],
      "patterns": [
        "The 10,000 number is a target",
        "sandbox has no Java/JDK",
        "A strict\\s+result is evidence only"
      ]
    }
  ],
  "forbidden_patterns": [
    {
      "id": "no-false-green-wrapper",
      "globs": [
        "nova-tv/python/nova/cli.py"
      ],
      "patterns": [
        "\"ok\": True, \"tool\": name, \"result\": result"
      ],
      "strip_comments": true
    },
    {
      "id": "no-hardcoded-claim-green",
      "globs": [
        "nova-tv/python/scripts/verify_claims.py"
      ],
      "patterns": [
        "\"ok\":\\s*True"
      ],
      "strip_comments": true
    },
    {
      "id": "no-workflow-warn-or-ignore-uploads",
      "globs": [
        ".github/workflows/*.yml"
      ],
      "patterns": [
        "if-no-files-found:\\s*(warn|ignore)"
      ],
      "strip_comments": true
    },
    {
      "id": "no-top-level-green-smoke",
      "globs": [
        ".github/workflows/*.yml"
      ],
      "patterns": [
        "grep.*\"ok\"\\s*:\\s*true"
      ],
      "strip_comments": true
    },
    {
      "id": "no-workflow-swallowed-failure",
      "globs": [
        ".github/workflows/*.yml"
      ],
      "patterns": [
        "\\|\\|\\s*true",
        "(?m)^\\s*exit\\s+0\\s*$"
      ],
      "strip_comments": true
    },
    {
      "id": "no-skipped-python-tests",
      "globs": [
        "nova-tv/python/tests/*.py"
      ],
      "patterns": [
        "@unittest\\.skip",
        "@skip"
      ],
      "strip_comments": true
    },
    {
      "id": "no-pipeline-stub-or-swallow-markers",
      "globs": [
        "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/*.kt"
      ],
      "patterns": [
        "TODO",
        "FIXME",
        "NotImplemented",
        "runCatching",
        "getOrDefault"
      ],
      "strip_comments": true
    }
  ],
  "source_claims": [
    {
      "id": "gate-schema-version-is-explicit",
      "kind": "literal_count",
      "path": "tools/nova/strict_verify.py",
      "literal": "SCHEMA_VERSION = 1",
      "min": 1,
      "max": 1
    },
    {
      "id": "engine-configurations-are-65",
      "kind": "regex_count",
      "path": "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/DiscoveryEngines.kt",
      "regex": "(?m)^\\s+id = \"",
      "min": 65,
      "max": 65
    },
    {
      "id": "engine-families-are-65",
      "kind": "regex_count",
      "path": "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/DiscoveryEngines.kt",
      "regex": "(?m)^\\s+family = \"",
      "min": 65,
      "max": 65
    },
    {
      "id": "fourteen-explicit-stages",
      "kind": "regex_count",
      "path": "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineModels.kt",
      "regex": "(?m)^\\s+[A-Z_]+\\(\"\\d{2}-[a-z]+\"\\)",
      "min": 14,
      "max": 14
    },
    {
      "id": "site-target-is-10000",
      "kind": "literal_count",
      "path": "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineModels.kt",
      "literal": "MIN_SITE_TARGET = 10_000",
      "min": 1,
      "max": 1
    },
    {
      "id": "pool-cap-is-10000",
      "kind": "literal_count",
      "path": "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineModels.kt",
      "literal": "POOL_CAP = 10_000",
      "min": 1,
      "max": 1
    },
    {
      "id": "engine-floor-is-50",
      "kind": "literal_count",
      "path": "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineModels.kt",
      "literal": "MIN_ENGINE_COUNT = 50",
      "min": 1,
      "max": 1
    },
    {
      "id": "build-marker-is-exact",
      "kind": "literal_count",
      "path": "nova-tv/android/app/src/main/java/dev/nova/tv/finder/pipeline/PipelineModels.kt",
      "literal": "PIPELINE_BUILD_MARKER = \"nova-finder-pipeline-v3\"",
      "min": 1,
      "max": 1
    },
    {
      "id": "pipeline-tests-assert-two-10000-targets",
      "kind": "literal_count",
      "path": "nova-tv/android/app/src/test/java/dev/nova/tv/finder/pipeline/PipelineRunnerTest.kt",
      "literal": "assertEquals(MIN_SITE_TARGET, second.verifiedCount)",
      "min": 2,
      "max": 2
    },
    {
      "id": "application-wires-website-runner",
      "kind": "literal_count",
      "path": "nova-tv/android/app/src/main/java/dev/nova/tv/NovaApplication.kt",
      "literal": "pipeline = serverPipelineRunner",
      "min": 1,
      "max": 1
    },
    {
      "id": "application-wires-addon-runner",
      "kind": "literal_count",
      "path": "nova-tv/android/app/src/main/java/dev/nova/tv/NovaApplication.kt",
      "literal": "pipeline = addonPipelineRunner",
      "min": 1,
      "max": 1
    },
    {
      "id": "ci-runs-tv-flavour-tests",
      "kind": "literal_count",
      "path": ".github/workflows/nova-tv-android.yml",
      "literal": "testTvDebugUnitTest",
      "min": 1,
      "max": 10
    },
    {
      "id": "ci-runs-mobile-flavour-tests",
      "kind": "literal_count",
      "path": ".github/workflows/nova-tv-android.yml",
      "literal": "testMobileDebugUnitTest",
      "min": 1,
      "max": 10
    },
    {
      "id": "seven-offline-gates-are-explicit",
      "kind": "regex_count",
      "path": "nova-tv/python/ops/qa_offline_gates.py",
      "regex": "(?m)^    \\(\"",
      "min": 7,
      "max": 7
    },
    {
      "id": "strict-result-module-is-explicit",
      "kind": "literal_count",
      "path": "nova-tv/python/nova/result.py",
      "literal": "def result_failures(result: Any, path: str = \"result\")",
      "min": 1,
      "max": 1
    }
  ],
  "commands": [
    {
      "id": "strict-gate-self-tests",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tools/nova/tests",
        "-t",
        "tools/nova",
        "-v"
      ],
      "cwd": ".",
      "profiles": [
        "local",
        "ci"
      ],
      "timeout": 60,
      "expect_exit": 0,
      "required_stdout": [
        "(?m)^OK$",
        "Ran 8 tests"
      ],
      "forbidden_stdout": [
        "FAILED",
        "Traceback"
      ]
    },
    {
      "id": "python-unittests",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "nova-tv/python/tests",
