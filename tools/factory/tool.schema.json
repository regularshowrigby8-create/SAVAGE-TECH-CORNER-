{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "tools"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tools": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "command",
          "profiles",
          "upstream",
          "kind",
          "requires",
          "network",
          "timeout_seconds",
          "install",
          "source_writes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 10
          },
          "command": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "upstream": {
            "type": "string",
            "pattern": "^https://"
          },
          "kind": {
            "enum": ["check", "report", "search", "secret-scan"]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "network": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800
          },
          "install": {
            "type": "object"
          },
          "source_writes": {
            "const": false
          },
          "setup": {
            "enum": ["mutation", "compose", "browser"]
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "format"],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "enum": ["json", "binary"]
                },
                "count_field": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
