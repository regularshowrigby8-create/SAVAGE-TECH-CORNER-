<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permissions are deliberately minimal:
          * INTERNET             - required to render any web page.
          * ACCESS_NETWORK_STATE - required to distinguish "offline" from "failed load" so the
                                   offline state can be shown instead of a raw WebView error.
        No storage, location, camera, microphone, contacts or notification permission is declared.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SavageBrowserApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SavageBrowser"
        android:usesCleartextTraffic="false">

        <!-- Fail-closed WebView hardening signal: Safe Browsing is requested on API 26+. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SavageBrowser"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                The browser is also a link target. Both https and http are declared so that a
                cleartext link is received and then *refused* with an explicit message, instead
                of being handed to an activity that would silently honour it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.BookmarksActivity"
            android:exported="false"
            android:label="@string/title_bookmarks"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.SavageBrowser.Screens" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/title_history"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.SavageBrowser.Screens" />
    </application>
</manifest>
