{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelDiagnosis",
  "type": "object",
  "required": [
    "status",
    "model",
    "engine",
    "remediations",
    "confidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "REJECTED", "ESCALATED", "SYMBOLIC_AST_EXECUTION_SUCCESS"]
    },
    "model": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "server": {
      "type": "string"
    },
    "response": {
      "type": "string"
    },
    "remediations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "additionalProperties": true
}
