{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorPacket",
  "type": "object",
  "required": [
    "packet_id",
    "timestamp",
    "target",
    "findings",
    "retry_count",
    "max_retries",
    "status"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^ERR_PKT_[0-9]{8}_[0-9]{6}_[a-zA-Z0-9_-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "tool", "description"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "ERROR", "WARNING", "INFO"]
          },
          "tool": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          }
        }
      }
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_retries": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
