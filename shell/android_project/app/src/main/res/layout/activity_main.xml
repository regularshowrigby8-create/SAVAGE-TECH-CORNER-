<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16">

    <!-- Modern Translucent Top App Bar / Glass Omnibox 2.0 -->
    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Security Badge -->
            <TextView
                android:id="@+id/img_security_badge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="🔒"
                android:textSize="14sp" />

            <!-- Omnibox Capsule -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="#334155"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <EditText
                    android:id="@+id/edit_omnibox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search or enter URL"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_action_ai"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="#6366F1"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_action_refresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="↻"
                android:textColor="#CBD5E1"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Dynamic Electric Progress Bar -->
        <ProgressBar
            android:id="@+id/page_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0" />
    </LinearLayout>

    <!-- Main Native WebView Container -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/main_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Modern Floating Glassmorphism Bottom Navigation Dock 2.0 -->
    <LinearLayout
        android:id="@+id/bottom_navigation_dock"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/btn_nav_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◀"
            android:textColor="#F8FAFC"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_nav_forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▶"
            android:textColor="#F8FAFC"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂"
            android:textColor="#6366F1"
            android:textSize="22sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_nav_tabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="❐"
                android:textColor="#F8FAFC"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txt_tabs_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:background="#6366F1"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/btn_nav_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#F8FAFC"
            android:textSize="22sp" />
    </LinearLayout>

</LinearLayout>
