<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Modern Lighting Translucent Top App Bar / Glass Omnibox 2.0 -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B30F172A"
        app:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/img_security_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Security Status"
                android:src="@android:drawable/ic_lock_idle_lock"
                app:tint="#10B981" />

            <!-- Glass Omnibox Capsule -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:background="#33334155"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/edit_omnibox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search or type web address"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_action_ai"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="AI Assistant"
                    android:src="@android:drawable/ic_menu_compass"
                    app:tint="#6366F1" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_action_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh Page"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="#CBD5E1" />
        </LinearLayout>

        <!-- Dynamic Electric Indigo Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/page_progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@android:drawable/progress_horizontal" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Native WebView Container -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <WebView
            android:id="@+id/main_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Modern Floating Glassmorphism Bottom Navigation Dock 2.0 -->
    <LinearLayout
        android:id="@+id/bottom_navigation_dock"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:background="#D9090D16"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_nav_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Navigate Back"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#F8FAFC" />

        <ImageButton
            android:id="@+id/btn_nav_forward"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Navigate Forward"
            android:src="@android:drawable/ic_media_next"
            app:tint="#F8FAFC" />

        <ImageButton
            android:id="@+id/btn_nav_home"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go Home"
            android:src="@android:drawable/ic_menu_today"
            app:tint="#6366F1" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btn_nav_tabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open Tabs"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#F8FAFC" />

            <TextView
                android:id="@+id/txt_tabs_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="8dp"
                android:background="#6366F1"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_nav_menu"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More Options"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#F8FAFC" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
