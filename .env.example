# Environment Variables & Configuration Template
# Copy to .env for local developer workflows. DO NOT commit production secrets.

# ==============================================================================
# 1. Autonomous Factory Server Configuration
# ==============================================================================
PORT=8080
HOST=0.0.0.0
AUTONOMOUS_MODE=true

# ==============================================================================
# 2. Model Execution & Remote Inference Endpoints
# ==============================================================================
# Optional remote Ollama or vLLM GPU inference node URL
REMOTE_MODEL_SERVER_URL=http://127.0.0.1:11434

# GitHub Models Serverless Inference (Automatically populated in CI/developer environments)
# GITHUB_TOKEN=ghp_your_token_here

# ==============================================================================
# 3. Android Build & Packaging Configuration
# ==============================================================================
ANDROID_COMPILE_SDK=35
ANDROID_MIN_SDK=26
ANDROID_TARGET_SDK=35
APP_APPLICATION_ID=com.savage.soulbrowser
APP_VERSION_NAME=1.0.0
APP_VERSION_CODE=1
