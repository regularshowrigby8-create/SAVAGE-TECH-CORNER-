{
  "name": "savage-tech-corner",
  "version": "2.0.0",
  "description": "Savage Tech Corner - Factory & Browser Ecosystem with Fully Integrated Quality Conveyor Belt",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node tools/factory/dashboard.test.cjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "audit:security": "npm audit --audit-level=high",
    "conveyor-belt": "node scripts/conveyor_belt.js",
    "prepare": "husky install || true",
    "factory:overview": "python3 -m tools.factory.automation overview --publish-doc",
    "audit:deps": "node scripts/dep_auditor.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.49.0",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.10.3",
    "eslint": "^9.25.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.0",
    "prettier": "^3.5.3",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "path": "frontend/compose_user_interface/compose_ui.py",
      "limit": "50 KB"
    },
    {
      "path": "shell/soul_browser/browser_shell.py",
      "limit": "20 KB"
    }
  ]
}
