diff --git a/shell/tests/test_network_policy.py b/shell/tests/test_network_policy.py
new file mode 100644
index 0000000..031e128
--- /dev/null
+++ b/shell/tests/test_network_policy.py
@@ -0,0 +1,138 @@
+"""One network policy, every layer: the switch has to mean the same thing everywhere.
+
+The component used to answer "may I dial?" in four places with three answers. These tests pin the
+answer: `SEALED_NETWORK=off` is the default, `SEALED_NO_NETWORK=1` always forces it, and the tools,
+the swarm, the gateway and the sealed runtime all refuse before a socket is opened - including the
+model runtime, which used to keep dialling providers with the air-gap switch on.
+
+They are deliberately offline: a patched `urlopen` that raises on any call proves "did not dial"
+without needing a network to be absent.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+RUNTIME = REPO_ROOT / "sealed-factories" / "runtime"
+sys.path.insert(0, str(RUNTIME))
+sys.path.insert(0, str(REPO_ROOT / "tools" / "factory"))
+
+import gateway  # noqa: E402
+import netpolicy  # noqa: E402
+import swarm  # noqa: E402
+import toolkit  # noqa: E402
+import sealed_factory_runtime as runtime  # noqa: E402
+
+VARIABLES = ("SEALED_NETWORK", "SEALED_NO_NETWORK")
+
+
+class PolicyTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._saved = {name: os.environ.get(name) for name in VARIABLES}
+        self.addCleanup(self._restore)
+
+    def _restore(self) -> None:
+        for name, value in self._saved.items():
+            if value is None:
+                os.environ.pop(name, None)
+            else:
+                os.environ[name] = value
+
+    def _clear(self) -> None:
+        for name in VARIABLES:
+            os.environ.pop(name, None)
+
+    def test_the_default_is_off(self) -> None:
+        self._clear()
+        self.assertEqual(netpolicy.mode(), netpolicy.OFF)
+        self.assertFalse(netpolicy.allowed(netpolicy.LOCAL))
+        self.assertFalse(netpolicy.allowed(netpolicy.REMOTE))
+
+    def test_the_hard_switch_always_wins(self) -> None:
+        os.environ["SEALED_NETWORK"] = netpolicy.REMOTE
+        os.environ["SEALED_NO_NETWORK"] = "1"
+        self.assertEqual(netpolicy.mode(), netpolicy.OFF)
+        self.assertFalse(netpolicy.allowed(netpolicy.REMOTE))
+        self.assertIn("SEALED_NO_NETWORK", netpolicy.reason(netpolicy.REMOTE))
+
+    def test_local_mode_allows_only_this_machine(self) -> None:
+        self._clear()
+        os.environ["SEALED_NETWORK"] = netpolicy.LOCAL
+        self.assertTrue(netpolicy.allowed(netpolicy.LOCAL))
+        self.assertFalse(netpolicy.allowed(netpolicy.REMOTE))
+        self.assertEqual(netpolicy.kind_for_url("http://127.0.0.1:8787/v1/chat/completions"),
+                         netpolicy.LOCAL)
+        self.assertEqual(netpolicy.kind_for_url("https://api.openai.com/v1/chat/completions"),
+                         netpolicy.REMOTE)
+
+    def test_an_unknown_mode_is_off_not_a_free_pass(self) -> None:
+        os.environ["SEALED_NETWORK"] = "yes-please"
+        self.assertEqual(netpolicy.mode(), netpolicy.OFF)
+
+    def test_the_model_runtime_does_not_dial_when_off(self) -> None:
+        self._clear()
+        capabilities = {
+            "local_models": [{"name": "ollama", "url": "http://127.0.0.1:11434/api/generate"}],
+            "keyed_providers": [{"name": "openai", "url": "https://api.openai.com/v1/chat/completions",
+                                 "model": "gpt-4o-mini"}],
+            "model_available": True,
+        }
+        with mock.patch("urllib.request.urlopen", side_effect=AssertionError("a socket was opened")):
+            answer = runtime.call_model(capabilities, "prompt", timeout=1)
+        self.assertFalse(answer["ok"])
+        self.assertIn("network calls are disabled", answer["error"])
+
+    def test_a_keyed_provider_is_not_advertised_when_remote_is_off(self) -> None:
+        self._clear()
+        os.environ["OPENAI_API_KEY"] = "sk-" + "0" * 32
+        capabilities = runtime.detect_capabilities()
+        self.assertEqual(capabilities["keyed_providers"], [])
+        self.assertFalse(capabilities["model_available"])
+        self.assertEqual(capabilities["network"]["mode"], netpolicy.OFF)
+
+    def test_the_gateway_refuses_a_key_it_may_not_use(self) -> None:
+        self._clear()
+        saved = dict(gateway._KEYS)
+        self.addCleanup(lambda: (gateway._KEYS.clear(), gateway._KEYS.update(saved)))
+        gateway._KEYS.update({"openai": ["sk-" + "0" * 32]})
+        self.assertEqual(gateway.reachable(), [])
+        with self.assertRaises(gateway.GatewayError) as raised:
+            gateway.forward("openai", {"messages": [{"role": "user", "content": "x"}]})
+        self.assertIn("network calls are disabled", str(raised.exception))
+
+    def test_a_github_step_is_skipped_not_failed(self) -> None:
+        self._clear()
+        with tempfile.TemporaryDirectory() as scratch:
+            workspace = toolkit.Workspace(Path(scratch))
+            registry = toolkit.build_registry(workspace, "")
+            steps = swarm._run_steps(registry, ({"tool": "github.probe", "args": {}},), workspace)
+        self.assertEqual(len(steps), 1)
+        self.assertTrue(steps[0]["skipped"])
+        self.assertFalse(steps[0]["ok"])
+        self.assertIn("SEALED_NETWORK", steps[0]["reason"])
+
+    def test_the_tools_refuse_with_the_policy_reason(self) -> None:
+        self._clear()
+        with self.assertRaises(toolkit.ToolError) as raised:
+            toolkit.net_fetch("https://example.invalid/")
+        self.assertIn("SEALED_NETWORK=off", str(raised.exception))
+
+    def test_the_swarm_report_carries_the_policy(self) -> None:
+        self._clear()
+        with tempfile.TemporaryDirectory() as scratch:
+            (Path(scratch) / "README.md").write_text("# scratch\n", encoding="utf-8")
+            report = swarm.run(scratch, "test", instances=1, workers=2, execute_limit=3,
+                               model_calls=0)
+        self.assertEqual(report["network"]["mode"], netpolicy.OFF)
+        self.assertEqual(report["model"]["available"], False)
+        self.assertEqual(report["model"]["calls_made"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
