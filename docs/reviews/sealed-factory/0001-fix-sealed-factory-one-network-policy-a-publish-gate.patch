+
+The component used to answer that question in several places with several answers: the `net.*` and
+`github.*` tools refused under `SEALED_NO_NETWORK`, while the model runtime and the gateway kept
+dialling providers and local ports. A switch that stops two of the four ways out is worse than no
+switch, because the report says "offline" and the machine is not.
+
+This module is the single answer. Three modes:
+
+    off     no outbound socket of any kind (the default)
+    local   the gateway and local model servers on 127.0.0.1 only
+    remote  local plus the providers and the GitHub API
+
+Set it with `SEALED_NETWORK=off|local|remote` or `--allow-network` on the CLI. `SEALED_NO_NETWORK=1`
+keeps working and forces `off` regardless of the other value, so the air-gapped job's switch cannot
+be weakened by a later edit to a different variable.
+
+The mode is read at call time, never cached: a test, a gate and a user can change it between calls
+and every layer sees the same answer.
+"""
+
+from __future__ import annotations
+
+import os
+from urllib.parse import urlsplit
+
+OFF = "off"
+LOCAL = "local"
+REMOTE = "remote"
+MODES = (OFF, LOCAL, REMOTE)
+
+ENV = "SEALED_NETWORK"
+HARD_OFF = "SEALED_NO_NETWORK"
+
+_LOCAL_HOSTS = {"127.0.0.1", "::1", "localhost", "0.0.0.0"}
+
+
+class NetworkRefused(RuntimeError):
+    """Raised by `guard()` when the current policy does not permit the call."""
+
+
+def _truthy(value: str) -> bool:
+    return value.strip().lower() in ("1", "true", "yes", "on")
+
+
+def _raw_mode() -> str:
+    value = os.environ.get(ENV, OFF).strip().lower()
+    return value if value in MODES else OFF
+
+
+def mode() -> str:
+    """The effective mode. `SEALED_NO_NETWORK` always wins."""
+    if _truthy(os.environ.get(HARD_OFF, "")):
+        return OFF
+    return _raw_mode()
+
+
+def allowed(kind: str) -> bool:
+    """May a socket of this kind be opened? `kind` is `local` or `remote`."""
+    if kind not in (LOCAL, REMOTE):
+        raise ValueError(f"unknown network kind: {kind}")
+    current = mode()
+    if current == OFF:
+        return False
+    if current == LOCAL:
+        return kind == LOCAL
+    return True
+
+
+def reason(kind: str = REMOTE) -> str:
+    """Why the call is refused, naming the switch the operator actually set."""
+    if _truthy(os.environ.get(HARD_OFF, "")):
+        return f"network calls are disabled: {HARD_OFF} is set"
+    return (f"network calls are disabled: {ENV}={mode()} does not permit "
+            f"{kind} calls (use --allow-network {kind} or {ENV}={kind})")
+
+
+def guard(kind: str = REMOTE) -> None:
+    if not allowed(kind):
+        raise NetworkRefused(reason(kind))
+
+
+def is_local_url(url: str) -> bool:
+    """Is this URL on this machine? Hostname only: a port cannot make a host local."""
+    try:
+        host = urlsplit(url).hostname or ""
+    except ValueError:
+        return False
+    return host.lower() in _LOCAL_HOSTS
+
+
+def kind_for_url(url: str) -> str:
+    return LOCAL if is_local_url(url) else REMOTE
+
+
+#: Tools whose subject is outside this machine. `proc.run` is deliberately absent: a tool that runs a
+#: command cannot know what the command dials, and claiming otherwise would be the kind of invented
+#: assurance this module exists to remove.
+REMOTE_TOOL_PREFIXES = ("net.", "github.")
+
+#: Tools that only talk to this machine's own gateway.
+LOCAL_TOOL_PREFIXES = ("model.",)
+
+
+def kind_for_tool(name: str) -> str:
+    if name.startswith(REMOTE_TOOL_PREFIXES):
+        return REMOTE
+    if name.startswith(LOCAL_TOOL_PREFIXES):
+        return LOCAL
+    return ""
+
+
+def describe() -> dict:
+    current = mode()
+    return {
+        "mode": current,
+        "local": allowed(LOCAL),
+        "remote": allowed(REMOTE),
+        "source": HARD_OFF if _truthy(os.environ.get(HARD_OFF, "")) else ENV,
+        "note": (f"{HARD_OFF} forces off" if _truthy(os.environ.get(HARD_OFF, ""))
+                 else f"set {ENV}=off|local|remote to change it"),
+    }
