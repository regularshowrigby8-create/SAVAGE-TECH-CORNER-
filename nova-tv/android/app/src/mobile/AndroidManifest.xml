<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phones, tablets and Chromebooks. Touch is used when present, never required. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application>
        <!--
          Rotation is handled in Compose (configChanges), so turning the phone
          never restarts playback. The player asks for landscape itself and
          gives the orientation back when it closes. PiP lets a film keep
          playing over other apps.
        -->
        <activity
            android:name=".mobile.MobileActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Nova">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
