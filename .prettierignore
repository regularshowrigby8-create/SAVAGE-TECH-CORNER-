# Machine-written output. The factories rewrite these files on every run, so formatting them would
# be undone immediately and every factory run would then look like a formatting regression. Prettier
# checks the source a human maintains; the generated logs, reports and manifests are checked by the
# gates that own them (factory tests, provenance checks, schema validation).
workspace/
**/logs/
factory-2/reports/
factories/factory-2/reports/
docs/archive/
RELEASE_MANIFEST.json

# Build output and installed dependencies
node_modules/
build/
dist/
coverage/
.playwright/
.husky/_

# CI-generated scan output: the security scan step writes its SARIF report into the workspace, and
# Prettier would otherwise treat a machine-written result file as repository content and fail the
# style check on a file no human maintains.
*.sarif

# The sealed factory set: hash-verified data. Its records are written by the sealer, its
# payload hashes are recorded in SEAL.json, and reformatting them would rewrite a component
# whose whole point is that it is byte-exact. Its own tests verify it.
sealed-factories/

# Binary artefacts Prettier cannot parse
*.zip
*.apk
*.jar
*.aar
*.png
*.ico
